@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";

    // banniere globale : on prend le pire statut parmi tous les services
    string bannerClass;
    string bannerIcon;
    string bannerTitle;
    if (Model.Services.Any(s => s.Statut == "outage"))
    {
        bannerClass = "alert-danger";
        bannerIcon = "bi-x-octagon-fill";
        bannerTitle = "Panne majeure en cours";
    }
    else if (Model.Services.Any(s => s.Statut == "degraded"))
    {
        bannerClass = "alert-warning";
        bannerIcon = "bi-exclamation-triangle-fill";
        bannerTitle = "Performance dégradée sur certains services";
    }
    else
    {
        bannerClass = "alert-success";
        bannerIcon = "bi-check-circle-fill";
        bannerTitle = "Tous les services sont opérationnels";
    }
}

<div class="alert @bannerClass d-flex align-items-center shadow-sm" role="alert">
    <i class="bi @bannerIcon fs-1 me-3"></i>
    <div>
        <h4 class="alert-heading mb-1">@bannerTitle</h4>
        <small>Dernière mise à jour : @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</small>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card kpi-card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-semibold mb-2">
                    <i class="bi bi-hdd-network me-1"></i>Services surveillés
                </div>
                <div class="d-flex align-items-baseline gap-2">
                    <span class="display-4 fw-bold">@Model.Services.Count</span>
                    <span class="text-muted">au total</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card kpi-card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-semibold mb-2">
                    <i class="bi bi-exclamation-triangle me-1"></i>Incidents actifs
                </div>
                <div class="d-flex align-items-baseline gap-2">
                    <span class="display-4 fw-bold @(Model.ActiveIncidents.Count > 0 ? "text-danger" : "text-success")">@Model.ActiveIncidents.Count</span>
                    <span class="text-muted">en cours</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card kpi-card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-semibold mb-2">
                    <i class="bi bi-graph-up me-1"></i>Disponibilité moyenne
                </div>
                <div class="d-flex align-items-baseline gap-2">
                    @if (Model.UptimeAverage.HasValue)
                    {
                        <span class="display-4 fw-bold">@Model.UptimeAverage.Value.ToString("0.00")<span class="fs-3">%</span></span>
                        <span class="text-muted">sur 30 jours</span>
                    }
                    else
                    {
                        <span class="display-4 fw-bold text-muted">—</span>
                        <span class="text-muted">aucune donnée</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<section class="mb-5">
    <h2 class="h4 mb-3">
        <i class="bi bi-hdd-network me-1"></i>Services surveillés
        <span class="badge bg-secondary">@Model.Services.Count</span>
    </h2>
    @if (Model.Services.Count == 0)
    {
        <p class="text-muted">Aucun service enregistré.</p>
    }
    else
    {
        @foreach (var s in Model.Services)
        {
            <partial name="_ServiceCard" model="s" />
        }
    }
</section>

<section>
    <h2 class="h4 mb-3">
        <i class="bi bi-exclamation-triangle me-1"></i>Incidents en cours
        @if (Model.ActiveIncidents.Count > 0)
        {
            <span class="badge bg-danger">@Model.ActiveIncidents.Count</span>
        }
    </h2>
    @if (Model.ActiveIncidents.Count == 0)
    {
        <div class="card shadow-sm">
            <div class="card-body d-flex align-items-center">
                <i class="bi bi-check2-circle fs-4 me-2 text-success"></i>
                Aucun incident en cours. Tout va bien.
            </div>
        </div>
    }
    else
    {
        <div class="list-group shadow-sm">
        @foreach (var i in Model.ActiveIncidents)
        {
            <a asp-page="/Incidents/Details" asp-route-id="@i.Id" class="list-group-item list-group-item-action">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-1">@i.Titre</h6>
                        <small class="text-muted">
                            <i class="bi bi-hdd-network"></i> @i.ServiceNom
                            · <i class="bi bi-clock"></i> depuis @i.DateDebut.ToString("dd/MM/yyyy HH:mm")
                        </small>
                    </div>
                    <div class="d-flex gap-2 align-items-center">
                        <partial name="_StatusBadge" model="@i.Severite" />
                        <partial name="_StatusBadge" model="@i.Statut" />
                    </div>
                </div>
            </a>
        }
        </div>
        <div class="mt-3">
            <a asp-page="/Incidents/Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-clock-history me-1"></i>Voir l'historique complet
            </a>
        </div>
    }
</section>
