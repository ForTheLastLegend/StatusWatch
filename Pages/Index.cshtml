@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1>StatusWatch</h1>
<p class="lead">État des services en temps réel.</p>

<section class="mb-5">
    <h2>Services</h2>
    @foreach (var s in Model.Services)
    {
        <partial name="_ServiceCard" model="s" />
    }
</section>

<section>
    <h2>Incidents en cours</h2>
    @if (Model.ActiveIncidents.Count == 0)
    {
        <p>Aucun incident en cours. Tout va bien.</p>
    }
    else
    {
        <ul>
        @foreach (var i in Model.ActiveIncidents)
        {
            <li>
                <a asp-page="/Incidents/Details" asp-route-id="@i.Id">@i.Titre</a>
                - <strong>@i.ServiceNom</strong>
                - @i.Severite / @i.Statut
                - depuis @i.DateDebut.ToString("dd/MM/yyyy HH:mm")
            </li>
        }
        </ul>
    }
</section>
