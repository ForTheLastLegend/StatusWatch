@page "/Errors/404"
@model StatusWatch.Pages.Errors.NotFoundModel
@{
    ViewData["Title"] = "Page introuvable";
}

<div class="text-center py-5">
    <i class="bi bi-compass display-1 text-muted"></i>
    <h1 class="display-3 fw-bold mt-3 mb-0">404</h1>
    <h2 class="h4 text-muted mb-3">Page introuvable</h2>
    <p class="text-muted mb-4">La page que vous cherchez n'existe pas ou a été déplacée.</p>
    <a asp-page="/Index" class="btn btn-primary">
        <i class="bi bi-house me-1"></i>Retour à l'accueil
    </a>
</div>
