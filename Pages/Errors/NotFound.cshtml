@page "/Errors/404"
@model StatusWatch.Pages.Errors.NotFoundModel
@{
    ViewData["Title"] = "Page introuvable";
}

<div class="text-center py-5">
    <h1 class="display-4">404</h1>
    <h2>Page introuvable</h2>
    <p class="text-muted">La page que tu cherches n'existe pas ou a été déplacée.</p>
    <p>
        <a asp-page="/Index" class="btn btn-primary">Retour à l'accueil</a>
    </p>
</div>
