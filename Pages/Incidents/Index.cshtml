@page
@model StatusWatch.Pages.Incidents.IndexModel
@{
    ViewData["Title"] = "Incidents";
    var isAdmin = User.IsInRole("Admin");
}

<h1>Incidents</h1>

<p>@Model.Incidents.Count incident(s) au total.</p>

@if (isAdmin)
{
    <p>
        <a asp-page="/Admin/Incidents/Create" class="btn btn-primary">Nouvel incident</a>
    </p>
}

<table class="table">
    <thead>
        <tr>
            <th>Titre</th>
            <th>Service</th>
            <th>Sévérité</th>
            <th>Statut</th>
            <th>Début</th>
            <th>Fin</th>
            @if (isAdmin)
            {
                <th></th>
            }
        </tr>
    </thead>
    <tbody>
    @foreach (var i in Model.Incidents)
    {
        <tr>
            <td><a asp-page="Details" asp-route-id="@i.Id">@i.Titre</a></td>
            <td>@i.ServiceNom</td>
            <td>@i.Severite</td>
            <td>@i.Statut</td>
            <td>@i.DateDebut.ToString("dd/MM/yyyy HH:mm")</td>
            <td>@(i.DateFin?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
            @if (isAdmin)
            {
                <td>
                    <a asp-page="/Admin/Incidents/Edit" asp-route-id="@i.Id" class="btn btn-sm btn-outline-secondary">Modifier</a>
                    <a asp-page="/Admin/Incidents/Delete" asp-route-id="@i.Id" class="btn btn-sm btn-outline-danger">Supprimer</a>
                </td>
            }
        </tr>
    }
    </tbody>
</table>
