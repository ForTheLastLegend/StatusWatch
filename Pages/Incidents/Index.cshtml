@page
@model StatusWatch.Pages.Incidents.IndexModel
@{
    ViewData["Title"] = "Incidents";
    var isAdmin = User.IsInRole("Admin");
}

<h1>Incidents</h1>

@if (isAdmin)
{
    <p>
        <a asp-page="/Admin/Incidents/Create" class="btn btn-primary">Nouvel incident</a>
        <a asp-page="Index" asp-page-handler="Export" class="btn btn-outline-secondary">Exporter CSV</a>
    </p>
}

<form method="get" class="mb-3">
    <div class="row g-2">
        <div class="col-md-5">
            <input asp-for="Search" class="form-control" placeholder="Recherche titre ou description" />
        </div>
        <div class="col-md-3">
            <select asp-for="Statut" class="form-select">
                <option value="">tous les statuts</option>
                <option value="investigating">investigating</option>
                <option value="monitoring">monitoring</option>
                <option value="resolved">resolved</option>
            </select>
        </div>
        <div class="col-md-3">
            <select asp-for="Severite" class="form-select">
                <option value="">toutes les sévérités</option>
                <option value="minor">minor</option>
                <option value="major">major</option>
                <option value="critical">critical</option>
            </select>
        </div>
        <div class="col-md-1">
            <button type="submit" class="btn btn-primary w-100">Filtrer</button>
        </div>
    </div>
</form>

<p>@Model.TotalCount incident(s) trouvé(s) - page @Model.CurrentPage / @Model.TotalPages</p>

<table class="table">
    <thead>
        <tr>
            <th>Titre</th>
            <th>Service</th>
            <th>Sévérité</th>
            <th>Statut</th>
            <th>Début</th>
            <th>Fin</th>
            @if (isAdmin)
            {
                <th></th>
            }
        </tr>
    </thead>
    <tbody>
    @foreach (var i in Model.Incidents)
    {
        <tr>
            <td><a asp-page="Details" asp-route-id="@i.Id">@i.Titre</a></td>
            <td>@i.ServiceNom</td>
            <td>@i.Severite</td>
            <td>@i.Statut</td>
            <td>@i.DateDebut.ToString("dd/MM/yyyy HH:mm")</td>
            <td>@(i.DateFin?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
            @if (isAdmin)
            {
                <td>
                    <a asp-page="/Admin/Incidents/Edit" asp-route-id="@i.Id" class="btn btn-sm btn-outline-secondary">Modifier</a>
                    <a asp-page="/Admin/Incidents/Delete" asp-route-id="@i.Id" class="btn btn-sm btn-outline-danger">Supprimer</a>
                </td>
            }
        </tr>
    }
    </tbody>
</table>

@if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination">
            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-page="Index"
                   asp-route-search="@Model.Search"
                   asp-route-statut="@Model.Statut"
                   asp-route-severite="@Model.Severite"
                   asp-route-pagenumber="@(Model.CurrentPage - 1)">Précédent</a>
            </li>

            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-page="Index"
                       asp-route-search="@Model.Search"
                       asp-route-statut="@Model.Statut"
                       asp-route-severite="@Model.Severite"
                       asp-route-pagenumber="@p">@p</a>
                </li>
            }

            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-page="Index"
                   asp-route-search="@Model.Search"
                   asp-route-statut="@Model.Statut"
                   asp-route-severite="@Model.Severite"
                   asp-route-pagenumber="@(Model.CurrentPage + 1)">Suivant</a>
            </li>
        </ul>
    </nav>
}
