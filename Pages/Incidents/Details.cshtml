@page "/Incidents/{id:int}"
@model StatusWatch.Pages.Incidents.DetailsModel
@{
    ViewData["Title"] = Model.Incident.Titre;
}

<p><a asp-page="Index">&larr; Retour à la liste</a></p>

<div class="d-flex justify-content-between align-items-start">
    <h1>@Model.Incident.Titre</h1>
    @if (User.IsInRole("Admin"))
    {
        <a asp-page="/Admin/Incidents/Updates" asp-route-id="@Model.Incident.Id" class="btn btn-outline-primary">
            Gérer les mises à jour
        </a>
    }
</div>

<dl>
    <dt>Service</dt>
    <dd><a asp-page="/Services/Details" asp-route-id="@Model.Incident.ServiceId">@Model.Incident.ServiceNom</a></dd>

    <dt>Statut</dt>
    <dd>@Model.Incident.Statut</dd>

    <dt>Sévérité</dt>
    <dd>@Model.Incident.Severite</dd>

    <dt>Début</dt>
    <dd>@Model.Incident.DateDebut.ToString("dd/MM/yyyy HH:mm")</dd>

    <dt>Fin</dt>
    <dd>@(Model.Incident.DateFin?.ToString("dd/MM/yyyy HH:mm") ?? "en cours")</dd>

    <dt>Description</dt>
    <dd>@Model.Incident.Description</dd>
</dl>

<h3 class="mt-4">Mises à jour</h3>
@if (Model.Updates.Count == 0)
{
    <p class="text-muted">Aucune mise à jour publiée.</p>
}
else
{
    <ul class="list-group">
        @foreach (var u in Model.Updates)
        {
            <partial name="_IncidentUpdate" model="u" />
        }
    </ul>
}
