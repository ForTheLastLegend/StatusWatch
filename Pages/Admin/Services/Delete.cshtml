@page "{id:int}"
@model StatusWatch.Pages.Admin.Services.DeleteModel
@{
    ViewData["Title"] = "Supprimer le service";
}

<h1>Supprimer le service</h1>

@if (Model.HasActiveIncidents)
{
    <div class="alert alert-warning">
        Ce service a des incidents actifs (non résolus). La suppression est bloquée tant qu'ils ne sont pas tous résolus ou supprimés.
    </div>
}
else
{
    <p>Confirmer la suppression du service ci-dessous ? Cette action est irréversible</p>
}

<dl>
    <dt>Nom</dt>
    <dd>@Model.Service.Nom</dd>

    <dt>Catégorie</dt>
    <dd>@Model.Service.Categorie</dd>

    <dt>Statut</dt>
    <dd><partial name="_StatusBadge" model="@Model.Service.Statut" /></dd>
</dl>

<form method="post">
    <input type="hidden" asp-for="Service.Id" />
    <button type="submit" class="btn btn-danger" disabled="@Model.HasActiveIncidents">
        Supprimer définitivement
    </button>
    <a asp-page="Index" class="btn btn-link">Annuler</a>
</form>
