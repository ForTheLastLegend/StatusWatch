@page "/Services/{id:int}"
@model StatusWatch.Pages.Services.DetailsModel
@{
    ViewData["Title"] = Model.Service.Nom;
}

<p>
    <a asp-page="Index" class="text-decoration-none">
        <i class="bi bi-arrow-left"></i> Retour à la liste
    </a>
</p>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">
        <i class="bi bi-hdd-network me-1"></i>@Model.Service.Nom
    </h1>
    <partial name="_StatusBadge" model="@Model.Service.Statut" />
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Catégorie</dt>
            <dd class="col-sm-9">@(Model.Service.Categorie ?? "—")</dd>

            <dt class="col-sm-3">URL</dt>
            <dd class="col-sm-9">
                @if (!string.IsNullOrWhiteSpace(Model.Service.Url))
                {
                    <a href="@Model.Service.Url" target="_blank" rel="noopener">@Model.Service.Url</a>
                }
                else
                {
                    <span class="text-muted">—</span>
                }
            </dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@(Model.Service.Description ?? "—")</dd>
        </dl>
    </div>
</div>

<h2 class="h5 mb-3"><i class="bi bi-graph-up me-1"></i>Disponibilité</h2>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        @if (Model.UptimePercent.HasValue)
        {
            var uptimeClass = Model.UptimePercent.Value >= 99 ? "text-success"
                            : Model.UptimePercent.Value >= 95 ? "text-warning"
                            : "text-danger";
            <div class="d-flex align-items-baseline gap-2">
                <span class="display-4 fw-bold @uptimeClass">@Model.UptimePercent.Value.ToString("0.##")%</span>
                <span class="text-muted">d'uptime sur 30 jours</span>
            </div>
        }
        else
        {
            <p class="text-muted mb-0"><em>Pas encore de données de ping.</em></p>
        }
    </div>
</div>

<h2 class="h5 mb-3"><i class="bi bi-activity me-1"></i>Historique des pings (24 dernières heures)</h2>

@if (Model.LatencyHistory.Count == 0)
{
    <p class="text-muted">Aucun ping enregistré sur cette période.</p>
}
else
{
    <div class="table-responsive shadow-sm mb-4">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Date</th>
                    <th>Statut</th>
                    <th class="text-end">Latence (ms)</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var p in Model.LatencyHistory)
            {
                <tr>
                    <td class="small">@p.CheckedAt.ToString("dd/MM/yyyy HH:mm:ss")</td>
                    <td>
                        @if (p.Statut == "up")
                        {
                            <span class="badge bg-success"><i class="bi bi-check-lg"></i> up</span>
                        }
                        else
                        {
                            <span class="badge bg-danger"><i class="bi bi-x-lg"></i> down</span>
                        }
                    </td>
                    <td class="text-end">@(p.LatenceMs?.ToString() ?? "—")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

<h2 class="h5 mb-3"><i class="bi bi-exclamation-triangle me-1"></i>Incidents</h2>

@if (Model.Incidents.Count == 0)
{
    <p class="text-muted">Aucun incident enregistré pour ce service.</p>
}
else
{
    <div class="table-responsive shadow-sm">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Titre</th>
                    <th>Sévérité</th>
                    <th>Statut</th>
                    <th>Début</th>
                    <th>Fin</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var i in Model.Incidents)
            {
                <tr>
                    <td>
                        <a asp-page="/Incidents/Details" asp-route-id="@i.Id" class="text-decoration-none fw-semibold">
                            @i.Titre
                        </a>
                    </td>
                    <td><partial name="_StatusBadge" model="@i.Severite" /></td>
                    <td><partial name="_StatusBadge" model="@i.Statut" /></td>
                    <td class="small">@i.DateDebut.ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="small">@(i.DateFin?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
