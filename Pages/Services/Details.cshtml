@page "/Services/{id:int}"
@model StatusWatch.Pages.Services.DetailsModel
@{
    ViewData["Title"] = Model.Service.Nom;
}

<p><a asp-page="Index">&larr; Retour à la liste</a></p>

<h1>@Model.Service.Nom</h1>

<dl>
    <dt>Catégorie</dt>
    <dd>@Model.Service.Categorie</dd>

    <dt>URL</dt>
    <dd>@Model.Service.Url</dd>

    <dt>Statut</dt>
    <dd>@Model.Service.Statut</dd>

    <dt>Description</dt>
    <dd>@Model.Service.Description</dd>
</dl>

<h2>Disponibilité</h2>

<p>
    Uptime sur 30 jours :
    @if (Model.UptimePercent.HasValue)
    {
        <strong>@Model.UptimePercent.Value.ToString("0.##")%</strong>
    }
    else
    {
        <em>pas encore de données de ping</em>
    }
</p>

<h2>Historique des pings (24 dernières heures)</h2>

@if (Model.LatencyHistory.Count == 0)
{
    <p>Aucun ping enregistré sur cette période.</p>
}
else
{
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Date</th>
                <th>Statut</th>
                <th>Latence (ms)</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var p in Model.LatencyHistory)
        {
            <tr>
                <td>@p.CheckedAt.ToString("dd/MM/yyyy HH:mm:ss")</td>
                <td>@p.Statut</td>
                <td>@(p.LatenceMs?.ToString() ?? "-")</td>
            </tr>
        }
        </tbody>
    </table>
}

<h2>Incidents</h2>

@if (Model.Incidents.Count == 0)
{
    <p>Aucun incident enregistré pour ce service.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Titre</th>
                <th>Sévérité</th>
                <th>Statut</th>
                <th>Début</th>
                <th>Fin</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var i in Model.Incidents)
        {
            <tr>
                <td><a asp-page="/Incidents/Details" asp-route-id="@i.Id">@i.Titre</a></td>
                <td>@i.Severite</td>
                <td>@i.Statut</td>
                <td>@i.DateDebut.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@(i.DateFin?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
            </tr>
        }
        </tbody>
    </table>
}
