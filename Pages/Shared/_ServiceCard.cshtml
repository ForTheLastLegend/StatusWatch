@model StatusWatch.Models.Service
@inject StatusWatch.Services.PingService PingService

@{
    var accentColor = Model.Statut switch
    {
        "operational" => "var(--bs-success)",
        "degraded" => "var(--bs-warning)",
        "outage" => "var(--bs-danger)",
        _ => "var(--bs-secondary)"
    };

    // pings sur 24h, on inverse pour avoir gauche=ancien et droite=recent
    var pings = PingService.GetLatencyHistory(Model.Id, 24);
    pings.Reverse();

    // downsampling pour pas avoir 200 barres a 1px ; on vise ~40 barres
    var step = Math.Max(1, pings.Count / 40);
    var sparkline = pings.Where((_, i) => i % step == 0).ToList();
    var lastPing = pings.LastOrDefault();
}

<div class="card service-card mb-2 shadow-sm" style="border-left: 4px solid @accentColor;">
    <div class="card-body d-flex justify-content-between align-items-center gap-3">
        <div class="flex-grow-1 min-width-0">
            <h5 class="card-title mb-1">
                <a asp-page="/Services/Details" asp-route-id="@Model.Id" class="text-decoration-none">
                    @Model.Nom
                </a>
            </h5>
            <div class="small text-muted">
                @if (!string.IsNullOrWhiteSpace(Model.Categorie))
                {
                    <span><i class="bi bi-tag"></i> @Model.Categorie</span>
                }
                @if (lastPing is not null && lastPing.LatenceMs.HasValue)
                {
                    <span class="ms-2"><i class="bi bi-speedometer2"></i> @lastPing.LatenceMs ms</span>
                }
            </div>
            @if (sparkline.Count > 0)
            {
                <div class="sparkline mt-2" title="Pings sur les 24 dernières heures">
                    @foreach (var p in sparkline)
                    {
                        var barClass = p.Statut == "up" ? "sparkbar-up" : "sparkbar-down";
                        <span class="sparkbar @barClass"></span>
                    }
                </div>
            }
        </div>
        <partial name="_StatusBadge" model="@Model.Statut" />
    </div>
</div>
