@model StatusWatch.Models.Service

@{
    var badgeClass = Model.Statut switch
    {
        "operational" => "bg-success",
        "degraded" => "bg-warning text-dark",
        "outage" => "bg-danger",
        _ => "bg-secondary"
    };
}

<div class="card mb-2">
    <div class="card-body d-flex justify-content-between align-items-center">
        <div>
            <h5 class="card-title mb-1">
                <a asp-page="/Services/Details" asp-route-id="@Model.Id">@Model.Nom</a>
            </h5>
            <small class="text-muted">@Model.Categorie</small>
        </div>
        <span class="badge @badgeClass">@Model.Statut</span>
    </div>
</div>
