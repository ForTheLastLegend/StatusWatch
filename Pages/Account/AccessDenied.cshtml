@page
@model StatusWatch.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Accès refusé";
}

<div class="text-center py-5">
    <i class="bi bi-shield-lock display-1 text-warning"></i>
    <h1 class="display-4 fw-bold mt-3 mb-0">403</h1>
    <h2 class="h4 text-muted mb-3">Accès refusé</h2>
    <p class="text-muted mb-4">Vous n'avez pas les droits nécessaires pour voir cette page.</p>
    <a asp-page="/Index" class="btn btn-primary">
        <i class="bi bi-house me-1"></i>Retour à l'accueil
    </a>
</div>
