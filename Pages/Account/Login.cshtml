@page
@model StatusWatch.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Connexion";
}

<h1>Connexion</h1>

<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label">Email</label>
        <input asp-for="Input.Email" class="form-control" autocomplete="email" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Password" class="form-label">Mot de passe</label>
        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Se connecter</button>
    <a asp-page="Register" class="btn btn-link">Créer un compte</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
