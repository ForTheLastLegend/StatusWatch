@page
@model StatusWatch.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Inscription";
}

<h1>Créer un compte</h1>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Input.Nom" class="form-label">Nom</label>
        <input asp-for="Input.Nom" class="form-control" />
        <span asp-validation-for="Input.Nom" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label">Email</label>
        <input asp-for="Input.Email" class="form-control" autocomplete="email" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Password" class="form-label">Mot de passe</label>
        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.ConfirmPassword" class="form-label">Confirmation</label>
        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">S'inscrire</button>
    <a asp-page="Login" class="btn btn-link">J'ai déjà un compte</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
